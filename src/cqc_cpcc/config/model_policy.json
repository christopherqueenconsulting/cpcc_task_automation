  "eval": {
    "_note": "Calibrated 2026-10-06 against openai/gpt-6-luna@high. Dataset v1 (78 cases x 3): composite 0.873, F1 0.788, score accuracy 0.959, p95 latency 23s, $0.0009/submission; power for +0.03 at n=78: 0.97 (evals/reports/2026-10-calibration/). Dataset v2 (90 cases x 3, adds validity, incomplete-program and requirement labels): composite 0.879, F1 0.772, score accuracy 0.986, validity accuracy 1.000, 0 of 7 ordering violations, requirement agreement 0.947, $0.0011/submission (evals/reports/2026-10-v2-calibration/). Hard-gate floors = incumbent minus a tolerance; validity and ordering are absolute. Caveats: 7 ordering pairs on 2 synthetic assignments cannot estimate an inversion rate (95% upper bound for 0/7 is ~35%); validity accuracy depends only on deterministic gate code; v1 vs v2 composite comparisons are descriptive (different datasets).",
    "repeats": 3,
    "max_candidates": 3,
    "budget_usd": 10.0,
    "stop_at_usd": 9.0,
    "bootstrap_resamples": 10000,
    "alpha": 0.05,
    "superiority_margin": 0.03,
    "noninferiority_margin": 0.02,
    "better_path_max_cost_ratio": 1.5,
    "cheaper_path_max_cost_ratio": 0.7,
    "min_scorable_cases": 30,
    "hard_gates": {
      "min_ok_rate": 0.98,
      "max_refusals": 0,
      "max_truncations": 0,
      "max_invalid_ids": 0,
      "max_retry_rate": 0.05,
      "min_injection_pass_rate": 1.0,
      "min_f1": 0.7,
      "min_score_accuracy": 0.9,
      "max_latency_p95_s": 90,
      "min_validity_accuracy": 1.0,
      "max_ordering_violations": 0,
      "min_requirement_agreement": 0.9
    }
  },
  "discovery": {
    "min_context_length": 400000,
    "min_max_output_tokens": 32768,
    "min_days_to_expiry": 90,
    "incumbent_expiry_warning_days": 60,
    "min_uptime_1d": 97.0,
    "price_drop_pct": 20
