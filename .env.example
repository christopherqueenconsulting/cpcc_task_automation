# CPCC Task Automation Environment Variables
# Copy this file to .streamlit/secrets.toml and fill in your values

# ===== AI API Keys =====
# OpenAI API key for AI features (legacy, optional if using OpenRouter)
OPENAI_API_KEY=sk-...

# OpenRouter API key for AI routing (recommended)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-...

# OpenRouter Auto-Router Allowed Models (optional)
# Comma-separated list of model patterns. Supports wildcards (*).
# When set, restricts the auto-router to only these model patterns.
# When empty or unset, uses your OpenRouter account's default settings.
# Examples:
#   - Single provider: google/gemini-*
#   - Multiple providers: google/gemini-*,meta-llama/llama-3*-instruct,mistralai/mistral-large*
#   - Specific models: anthropic/claude-3-opus,openai/gpt-4-turbo
# Leave empty to use your OpenRouter account's default settings
OPENROUTER_ALLOWED_MODELS=

# ===== CPCC Credentials =====
# MyColleges/BrightSpace login credentials
INSTRUCTOR_USERID=your_username
INSTRUCTOR_PASS=your_password
INSTRUCTOR_NAME=Professor Name

# Signature for feedback documents
FEEDBACK_SIGNATURE=Professor Name

# Online Attendance Tracker workbook (optional).
# Microsoft/SharePoint-hosted Excel is the supported target.
ATTENDANCE_TRACKER_URL=https://yourtenant.sharepoint.com/:x:/r/sites/.../Attendance%20Tracker.xlsx

# ===== Withdrawals =====

# Directory holding the local withdrawals CSV files. One file per term, named
# withdrawals_<Semester>_<Year>.csv. Required by PROCESS_WITHDRAWALS: it has no
# default so student data is never written to a surprise location.
WITHDRAWALS_CSV_DIR=./output/withdrawals

# Dry run the online tracker sync (default true). While true, the sync navigates,
# reads existing rows, and reports what it WOULD append without changing anything.
WITHDRAWALS_TRACKER_DRY_RUN=true

# EVA / census date. Taken from the course's "last day to drop without a grade"
# (verified live: that IS the census date). These only affect the fallback used when
# that field is blank, and the warning when the two disagree.
EVA_DATE_PERCENT=10
EVA_DATE_DRIFT_WARNING_DAYS=2

# ===== Browser Automation Settings =====
# Run browser in headless mode (recommended for production)
HEADLESS_BROWSER=true

# Default Selenium browser/docker selection. When set, these skip the interactive
# console prompts (handy for unattended runs / the web app). Accept the enum name
# or its number. Leave unset/blank to be prompted.
#   BROWSER_TYPE: DOCKER_CHROME | LOCAL_CHROME | BROWSERLESS   (1 | 2 | 3)
#   DOCKER_TYPE:  LOCAL | REMOTE                               (1 | 2)
BROWSER_TYPE=DOCKER_CHROME
DOCKER_TYPE=LOCAL

# Use a virtual X11 display (Linux only) instead of headless mode when available.
# When true, Chrome runs inside a virtual display (Xvfb) that is invisible to
# the local user, so it never steals focus or mouse/keyboard control.
# Useful for maintaining persistent browser sessions on a Linux workstation
# while still letting the user work normally on their machine.
# If a virtual display is not available or not running, browser startup may
# still fall back to headless mode, including on non-Linux systems.
USE_VIRTUAL_DISPLAY=false

# ----- Dockerized Selenium (DOCKER_CHROME browser type) -----
# Compose project name. Namespaces the stack so containers/networks don't
# collide with other projects that also run a "selenium-chrome" service.
COMPOSE_PROJECT_NAME=cpcc_task_automation

# Host ports the Selenium container is published on. Defaults are intentionally
# non-standard (Selenium defaults are 4444/7900) so they don't conflict with
# other projects binding the default ports. Change these if they're already taken.
SELENIUM_HOST_PORT=14444
SELENIUM_VNC_PORT=17900

# Selenium wait timeout in seconds
WAIT_DEFAULT_TIMEOUT=30

# Maximum retries for wait operations
MAX_WAIT_RETRY=3

# ===== AI Settings =====
# Maximum retries for LLM output parsing
RETRY_PARSER_MAX_RETRY=3

# Show line numbers in error feedback
SHOW_ERROR_LINE_NUMBERS=false

# ===== Debug Settings =====
# Enable debug logging
DEBUG=false

# OpenAI debug mode (logs all API calls)
CQC_OPENAI_DEBUG=false

# Redact sensitive data in debug logs
CQC_OPENAI_DEBUG_REDACT=true

# Directory to save debug logs (optional)
CQC_OPENAI_DEBUG_SAVE_DIR=

# Test mode (for E2E testing with deterministic responses)
CQC_TEST_MODE=false

# ===== LLM Analytics (optional) =====

# PostHog project key. Unset = telemetry is a complete no-op.
# Requires the optional dependency: poetry install -E telemetry
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_LLM_ANALYTICS=true

# PRIVACY: prompts contain student submissions and completions contain grades and
# feedback. Both are withheld by default. Only enable after confirming this is
# acceptable under your institution's FERPA obligations.
POSTHOG_LLM_CAPTURE_CONTENT=false
